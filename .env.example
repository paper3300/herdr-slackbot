# herdr-slackbot settings.
# This file belongs in the plugin config dir: `herdr plugin config-dir herdr-slackbot`
# (`python -m herdr_slackbot setup` creates it there). Restart the bridge after editing.

# --- Required -------------------------------------------------------------
# Bot User OAuth Token (OAuth & Permissions page, starts with xoxb-).
SLACK_BOT_TOKEN=
# App-Level Token with the connections:write scope (Basic Information page, starts with xapp-).
SLACK_APP_TOKEN=
# Your own Slack member ID (U...). Only this user is served. Leave it empty: the bridge then starts
# in pairing mode, shows a code in its pane, and fills this in when you run `/<cmd> pair <code>`.
# To pair another account later: clear it and restart the bridge.
SLACK_OWNER_USER_ID=

# --- Slack app identity (must match the app manifest) ---------------------
# Slash command, unique per user in the Slack workspace. Default: /herdr-<windows username>.
SLASH_COMMAND=
# Bot display name. Default: Herdr (<windows username>).
BOT_DISPLAY_NAME=

# --- Optional -------------------------------------------------------------
# Where state.json, bridge.log and the instance lock live. Default: <config dir>\state.
# STATE_DIR=
# DEBUG | INFO | WARNING
# LOG_LEVEL=INFO
# Result messages longer than this are truncated with a [전체 보기] button.
# RESULT_MAX_CHARS=3000
# Raw tail lines used when a response block can't be parsed (e.g. codex).
# FALLBACK_LINES=40
# Lines read from the agent screen for results.
# READ_LINES=200
# Herdr workspace that hosts the bridge (hidden from `new`).
# BRIDGE_WORKSPACE=herdr-slack
# Agent start timeout in milliseconds.
# START_TIMEOUT_MS=60000
# Seconds to wait after starting codex before the first prompt.
# CODEX_PROMPT_DELAY=3
# Seconds to watch for activity after a stalled prompt.
# STALL_WAIT=20
# Herdr executable / socket override (normally inherited from Herdr).
# HERDR_BIN=herdr
# HERDR_SOCKET_PATH=
